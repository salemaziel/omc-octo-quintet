#!/usr/bin/env bash
# quintet — unified CLI-agent orchestrator.
#
#   Persistent tmux worker teams across claude / codex / agy / copilot / qwen / opencode,
#   plus one-shot multi-AI fleet dispatch (consult / debate / review).
#
# Entry point. Sources the lib/, dispatches subcommands. Safe to symlink onto PATH.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

_quintet_src="${BASH_SOURCE[0]}"
while [ -h "$_quintet_src" ]; do
    _quintet_dir="$(cd -P "$(dirname "$_quintet_src")" >/dev/null 2>&1 && pwd)"
    _quintet_src="$(readlink "$_quintet_src")"
    [[ "$_quintet_src" != /* ]] && _quintet_src="${_quintet_dir}/${_quintet_src}"
done
QUINTET_ROOT="$(cd -P "$(dirname "$_quintet_src")/.." >/dev/null 2>&1 && pwd)"
export QUINTET_ROOT
# shellcheck source=/dev/null
source "${QUINTET_ROOT}/lib/common.sh"
source "${QUINTET_ROOT}/lib/providers.sh"
source "${QUINTET_ROOT}/lib/roles.sh"
source "${QUINTET_ROOT}/lib/reliability.sh"
source "${QUINTET_ROOT}/lib/tmux.sh"
source "${QUINTET_ROOT}/lib/team.sh"
source "${QUINTET_ROOT}/lib/fleet.sh"
source "${QUINTET_ROOT}/lib/prune.sh"

VERSION="$(have_jq && jq -r '.version' "${QUINTET_ROOT}/.claude-plugin/plugin.json" 2>/dev/null || echo "0.1.0")"

usage() {
cat <<'EOF'
quintet — orchestrate Claude Code, Codex, Antigravity (agy), Copilot, Qwen, and OpenCode CLIs.

TEAM MODE (persistent tmux worker teams):
  quintet team <spec> "<task>" [--cwd DIR] [--name NAME] [--tasks "t1||..."] [--safe]
                               [--model V] [--effort V] [--no-mcp] [--skip-auth-check]
  quintet team status   <name>
  quintet team doctor   <name>      # modal stalls + manifest/window check
  quintet team capture  <name> [worker] [lines]
  quintet team send      <name> <worker> "<text>" [--force] [--busy-ok]  # worker = exact name, e.g. w1-claude
  quintet team resume    <name> [worker]   # send kickoff tasks held on a dialog (all if no worker)
  quintet team restart   <name> <worker> [--force]  # respawn one exited worker from team.json and
                                                    # re-send its kickoff file; --force replaces a live one
  quintet team shutdown  <name> [--force] [--graceful[=N]]
                         # --graceful: ask each worker to stop and write a STOPPED line to the
                         # taskboard, wait until all are idle (at most N s, default 30), then kill
  quintet team list

  <spec> = comma-separated N:provider[:role[:model]] tokens, e.g.  2:claude:implementer,1:agy:stock

  --safe       drop the autonomy flags; workers then block on approval prompts,
               answer them with: quintet team send <name> <worker> "y" --force
  (kickoff)    a worker showing any dialog at kickoff (e.g. Claude's first-run
               "trust this folder") is HELD: its task is saved, not typed; answer
               the dialog, then run: quintet team resume <name> <worker>
  --force      (send) type even though the worker shows a dialog
  --busy-ok    (send) type even while the worker is mid-turn (the CLI may queue it)
  (inbox)      the kickoff task, and any send over 300 bytes or with a newline, goes to
               <cwd>/.quintet/inbox/<team>/ (0600, git-excluded); the worker gets a one-line nudge
  --model/--effort  a bare value (applies to every worker) or provider=value[,provider=value]
               e.g.  --model codex=gpt-6.1-sol,claude=opus
  --no-mcp     disable MCP where the provider supports it (WARN when only partial)
  --tasks      one pre-split subtask per worker, separated by ||
  --skip-auth-check  skip the (heuristic) provider auth pre-flight

FLEET MODE (one-shot multi-AI dispatch, runs in tmux by default):
  quintet fleet   "<prompt>" [providers] [--no-tmux] [--no-mcp] [--safe] [--model V] [--effort V]
                  [--deadline SECS]
  quintet consult "<prompt>" [providers] [same flags]    # alias of fleet (advisory)
  quintet debate  "<question>" [providers] [same flags]  # 2-round cross-critique
  quintet review  "<diff|file|desc>" [providers] [same flags] [--json]
                  # ends with a verdict table (verdict + high/med/low counts per seat;
                  # "unparsed" when a seat gave no valid JSON block). --json prints only
                  # that as a JSON array on stdout; the answers go to stderr.

  [providers] = "all" (default) | comma list, e.g.  claude,codex,agy,opencode
  --model/--effort take a bare value only with a single provider; otherwise use
  provider=value[,provider=value] (e.g. --model codex=gpt-6.1-sol).
  A prompt of "-" is read from stdin:  git diff | quintet review - claude,codex
  claude and codex take any prompt size; agy/copilot/qwen/opencode take up to 100 KB.
  --deadline   one time budget for the whole command (fallbacks and debate round 2
               are skipped under 20 s left); default: rounds x slowest timeout + 120 s
  Seat status: 0:ok, 0:truncated (over 2 MB), 1:empty, N:too-large, 124:timeout
  (any output shown as partial), 125:quota (provider skipped for 1 h), N:<class>.

UTILITIES:
  quintet doctor          # check CLIs, auth, tmux, jq
  quintet providers       # list provider readiness
  quintet roles           # list supported subagent worker roles
  quintet prune [--days N] [--dry-run]   # prune stale team states & old fleet sessions
                          # (--force is deprecated and does nothing)
  quintet version
EOF
}

cmd_doctor() {
    echo "quintet ${VERSION} — environment check"
    echo
    printf '%-10s %-12s %s\n' "TOOL" "STATUS" "DETAIL"
    printf '%-10s %-12s %s\n' "tmux" "$(quintet_tmux_available && echo ok || echo MISSING)" "$(quintet_tmux_available && printf '%s (%s)' "$(command -v tmux)" "$(tmux -V 2>/dev/null || echo 'version unknown')" || echo 'team mode unavailable')"
    printf '%-10s %-12s %s\n' "jq"   "$(have_jq && echo ok || echo missing)" "$(command -v jq || echo 'optional, manual JSON fallback used')"
    echo
    printf '%-10s %-12s %-14s %s\n' "PROVIDER" "INSTALLED" "AUTH" "HINT"
    local p inst auth
    for p in "${QUINTET_PROVIDERS[@]}"; do
        if quintet_provider_installed "$p"; then inst="yes"; else inst="NO"; fi
        auth="$(quintet_provider_auth "$p")"
        [[ "$auth" == "unknown" ]] && auth="unverified"
        local hint=""
        [[ "$inst" == "NO" ]] && hint="$(quintet_provider_install_hint "$p")"
        [[ "$inst" == "yes" && "$auth" == "none" ]] && hint="not authenticated"
        printf '%s %-8s %-12s %-14s %s\n' "$(quintet_provider_emoji "$p")" "$p" "$inst" "$auth" "$hint"
    done
    echo
    local ready=0
    for p in "${QUINTET_PROVIDERS[@]}"; do quintet_provider_ready "$p" && ready=$((ready+1)); done
    echo "Ready providers: ${ready}/${#QUINTET_PROVIDERS[@]}"
    [[ "$ready" -ge 1 ]] || { echo "⚠️  No providers ready — install/authenticate at least one."; return 1; }
}

cmd_providers() {
    local p
    for p in "${QUINTET_PROVIDERS[@]}"; do
        printf '%s %-8s installed=%-3s auth=%-12s ready=%s%s\n' \
            "$(quintet_provider_emoji "$p")" "$p" \
            "$(quintet_provider_installed "$p" && echo yes || echo no)" \
            "$(quintet_provider_auth "$p")" \
            "$(quintet_provider_ready "$p" && echo yes || echo no)" \
            "$(q=$(quota_blocked "$p") && echo " quota=until $(date -d "@$q" +%H:%M 2>/dev/null || echo "$q")")"
    done
}

main() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        team)
            local sub="${1:-}"
            case "$sub" in
                status)   shift; quintet_team_status "$@" ;;
                doctor)   shift; quintet_team_doctor "$@" ;;
                capture)  shift; quintet_team_capture "$@" ;;
                send)     shift; quintet_team_send "$@" ;;
                resume)   shift; quintet_team_resume "$@" ;;
                restart)  shift; quintet_team_restart "$@" ;;
                shutdown) shift; quintet_team_shutdown "$@" ;;
                list)     shift; quintet_team_list ;;
                ""|--help|-h) usage ;;
                *)        quintet_team_start "$@" ;;   # team <spec> <task> ...
            esac ;;
        fleet|consult) quintet_fleet_parallel "$@" ;;
        debate)        quintet_fleet_debate "$@" ;;
        review)        quintet_fleet_review "$@" ;;
        doctor)        cmd_doctor ;;
        providers)     cmd_providers ;;
        roles)         quintet_role_list ;;
        prune)         quintet_prune "$@" ;;
        __fleet_worker) quintet_fleet_worker "$@" ;;
        version|-v|--version) echo "quintet ${VERSION}" ;;
        help|-h|--help|"") usage ;;
        *) log ERROR "unknown command: $cmd"; usage; exit 1 ;;
    esac
}

main "$@"
